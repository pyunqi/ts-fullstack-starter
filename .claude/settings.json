{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm check)",
      "Bash(pnpm test)",
      "Bash(pnpm run ci)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm build)",
      "Bash(pnpm lint)",
      "Bash(pnpm db:generate)",
      "Bash(pnpm --filter:*)",
      "Bash(node scripts/check-:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ]
  }
}
