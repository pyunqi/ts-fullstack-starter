# 复制为 .env 后使用。.env 不会提交到 git。

# 本地开发指向真实的 SQLite 文件；生产环境改成 libsql://<db>-<org>.turso.io
DATABASE_URL=file:./data/dev.db

# 本地留空；生产环境填 Turso 的 auth token
DATABASE_AUTH_TOKEN=

# JWT 签名密钥。生产环境务必换成强随机字符串，例如 openssl rand -base64 48
JWT_SECRET=dev-only-change-me

# 邮件（Resend）。留空则不发信，只在日志里记一条 —— 本地开发和测试就靠这个不误发真邮件。
# 生产环境在托管平台后台配同名变量，别写进 netlify.toml / wrangler.jsonc（这两个文件会进 git）。
RESEND_API_KEY=

# 发件地址。域名必须在 Resend 里验证过（SPF/DKIM），否则发信一律 403。
# 发件人显示名和回复地址在后台「站点设置」里改，不在这里。
EMAIL_FROM=noreply@example.com

NODE_ENV=development
